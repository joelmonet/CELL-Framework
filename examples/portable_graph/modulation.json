    {"from": "pulse", "to": "position"},
    {"from": "position", "to": "output"}
  ],
  "automation": [],
  "intents": [],
  "lfos": [{"id": "motion", "rateHz": 100, "waveform": "triangle", "phase": 0.25}],
  "modulation": [
    {"source": "motion", "node": "level", "parameter": "gainDb", "depth": 6},
    {"source": "motion", "node": "pulse", "parameter": "depth", "depth": -0.25},
    {"source": "motion", "node": "position", "parameter": "pan", "depth": 0.8}
  ]
