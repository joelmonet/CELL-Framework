{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cell UI theme pack v1",
  "type": "object",
  "required": ["schema", "themes"],
  "properties": {
    "schema": {"const": "cell.ui-theme-pack.v1"},
    "assets": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/asset"}
    },
    "themes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/theme"}
    },
    "icons": {"$ref": "#/$defs/icons"},
    "manifest": {
      "type": "object",
      "required": ["version", "name"],
      "properties": {
        "version": {"const": 1},
        "name": {"$ref": "#/$defs/name"},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "themes": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "icons": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "fonts": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "previews": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "template": {
          "type": "object",
          "required": ["theme", "style"],
          "properties": {"theme": {"$ref": "#/$defs/id"}, "style": {"$ref": "#/$defs/styleId"}}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "styleId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:knob|slider|fader|button|meter|panel|dropdown|tab|icon-button)\\.)?[a-z][a-z0-9_-]*$"
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "role": {"enum": ["background", "surface", "text", "accent", "edge", "muted", "metal", "highlight", "shadow"]},
    "color": {
      "anyOf": [{"type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"}, {"$ref": "#/$defs/role"}]
    },
    "asset": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "data": {
          "type": "string",
          "maxLength": 1398136,
          "pattern": "^data:image/(png|webp|jpeg|svg[+]xml);base64,[A-Za-z0-9+/]+={0,2}$"
        },
        "path": {"type": "string", "maxLength": 240, "pattern": "^[\\w.-]+(/[\\w.-]+)*$"},
        "license": {"$ref": "#/$defs/name"},
        "description": {"$ref": "#/$defs/name"}
      },
      "oneOf": [{"required": ["data"]}, {"required": ["path"]}]
    },
    "effect": {
      "type": "object",
      "required": ["color"],
      "properties": {
        "color": {"$ref": "#/$defs/color"},
        "sigma": {"type": "number", "minimum": 0, "maximum": 18},
        "x": {"type": "number", "minimum": -16, "maximum": 16},
        "y": {"type": "number", "minimum": -16, "maximum": 16}
      }
    },
    "material": {
      "type": "object",
      "properties": {
        "fill": {"anyOf": [{"$ref": "#/$defs/color"}, {"type": "null"}]},
        "end": {"anyOf": [{"$ref": "#/$defs/color"}, {"type": "null"}]},
        "edge": {"anyOf": [{"$ref": "#/$defs/color"}, {"type": "null"}]},
        "highlight": {"anyOf": [{"$ref": "#/$defs/color"}, {"type": "null"}]},
        "edgeWidth": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 6}, {"type": "null"}]},
        "radius": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 48}, {"type": "null"}]},
        "opacity": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]},
        "shape": {"anyOf": [{"enum": ["rounded", "ellipse"]}, {"type": "null"}]},
        "asset": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "mask": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "shadow": {"anyOf": [{"$ref": "#/$defs/effect"}, {"type": "null"}]},
        "innerShadow": {"anyOf": [{"$ref": "#/$defs/effect"}, {"type": "null"}]},
        "glow": {"anyOf": [{"$ref": "#/$defs/effect"}, {"type": "null"}]},
        "vector": {
          "anyOf": [
            {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": {"type": "string", "maxLength": 1024, "pattern": "^[MLHVCSAZ][MLHVCSAZeE0-9+., -]*$"},
                "stroke": {"type": "number", "minimum": 0.1, "maximum": 6}
              }
            },
            {"type": "null"}
          ]
        },
        "gradient": {
          "anyOf": [
            {
              "type": "object",
              "required": ["kind", "stops"],
              "properties": {
                "kind": {"enum": ["solid", "linear", "radial", "conic"]},
                "angle": {"type": "number", "minimum": -360, "maximum": 360},
                "center": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {"type": "number", "minimum": 0, "maximum": 1}
                },
                "stops": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "required": ["color"],
                    "properties": {
                      "at": {"type": "number", "minimum": 0, "maximum": 1},
                      "color": {"$ref": "#/$defs/color"},
                      "opacity": {"type": "number", "minimum": 0, "maximum": 1}
                    }
                  }
                }
              }
            },
            {"type": "null"}
          ]
        },
        "corners": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {"type": "number", "minimum": 0, "maximum": 48}
            },
            {"type": "null"}
          ]
        },
        "borders": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": ["color"],
                "properties": {
                  "color": {"$ref": "#/$defs/color"},
                  "width": {"type": "number", "minimum": 0, "maximum": 16}
                }
              }
            },
            {"type": "null"}
          ]
        },
        "bevel": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {"enum": ["raised", "recessed"]},
                "width": {"type": "number", "minimum": 0, "maximum": 12},
                "angle": {"type": "number", "minimum": -360, "maximum": 360},
                "light": {"$ref": "#/$defs/color"},
                "dark": {"$ref": "#/$defs/color"}
              }
            },
            {"type": "null"}
          ]
        },
        "texture": {
          "anyOf": [
            {
              "type": "object",
              "required": ["asset"],
              "properties": {
                "asset": {"$ref": "#/$defs/id"},
                "fit": {"enum": ["stretch", "contain", "cover", "tile"]},
                "scale": {"type": "number", "minimum": 0.125, "maximum": 8},
                "offset": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {"type": "number", "minimum": -512, "maximum": 512}
                },
                "opacity": {"type": "number", "minimum": 0, "maximum": 1},
                "blend": {"enum": ["normal", "multiply", "screen"]}
              }
            },
            {"type": "null"}
          ]
        },
        "lighting": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "ambient": {"type": "number", "minimum": -1, "maximum": 1},
                "direction": {"type": "number", "minimum": -360, "maximum": 360},
                "intensity": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            {"type": "null"}
          ]
        },
        "finish": {"anyOf": [{"enum": ["matte", "satin", "polished"]}, {"type": "null"}]},
        "slices": {
          "anyOf": [
            {
              "type": "object",
              "required": ["insets"],
              "properties": {
                "insets": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {"type": "number", "minimum": 0, "maximum": 128}
                },
                "minimum": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {"type": "number", "minimum": 0, "maximum": 4096}
                },
                "edges": {"enum": ["stretch", "tile"]},
                "center": {"enum": ["stretch", "tile"]},
                "transparentCenter": {"type": "boolean"}
              }
            },
            {"type": "null"}
          ]
        },
        "icon": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "kind": {"enum": ["knob", "slider", "fader", "button", "meter", "panel", "dropdown", "tab", "icon-button"]},
    "layers": {
      "type": "object",
      "propertyNames": {"enum": ["background", "track", "face", "pointer", "highlight", "indicator", "foreground"]},
      "additionalProperties": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
    },
    "component": {
      "type": "object",
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "kind": {"$ref": "#/$defs/kind"},
        "layers": {"$ref": "#/$defs/layers"},
        "states": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "enabled",
              "hover",
              "pressed",
              "selected",
              "focus",
              "disabled",
              "bypassed",
              "automated",
              "modulated",
              "invalid",
              "warning"
            ]
          },
          "additionalProperties": {"$ref": "#/$defs/layers"}
        },
        "stack": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/stackLayer"}},
        "analysis": {"$ref": "#/$defs/id"},
        "geometry": {
          "type": "object",
          "properties": {
            "angles": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number", "minimum": -360, "maximum": 360}
            },
            "pivot": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "origin": {"type": "number", "minimum": 0, "maximum": 1},
            "cap": {"enum": ["stationary", "rotating"]},
            "arc": {"enum": ["none", "unipolar", "bipolar"]},
            "ticks": {"type": "number", "minimum": 0, "maximum": 64},
            "orientation": {"enum": ["horizontal", "vertical"]},
            "unity": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "typeface": {
      "type": "object",
      "properties": {
        "family": {"enum": ["panel-sans", "panel-condensed", "system-sans", "system-serif", "system-mono"]},
        "size": {"type": "number", "minimum": 8, "maximum": 96},
        "weight": {"type": "integer", "minimum": 100, "maximum": 900},
        "tracking": {"type": "number", "minimum": -2, "maximum": 12},
        "alignment": {"enum": ["left", "center", "right"]},
        "letterCase": {"enum": ["none", "uppercase", "lowercase"]}
      }
    },
    "theme": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "colors": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/role"},
          "additionalProperties": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
        },
        "typography": {
          "type": "object",
          "propertyNames": {"enum": ["label", "value"]},
          "additionalProperties": {"$ref": "#/$defs/typeface"}
        },
        "materials": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/material"}
        },
        "components": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"$ref": "#/$defs/styleId"},
          "additionalProperties": {"$ref": "#/$defs/component"}
        },
        "defaults": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/kind"},
          "additionalProperties": {"$ref": "#/$defs/styleId"}
        },
        "parent": {"$ref": "#/$defs/id"},
        "icons": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {"$ref": "#/$defs/name"},
                  "category": {"enum": ["module", "toolbar", "routing", "handle", "other"]},
                  "keywords": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/name"}},
                  "viewBox": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {"type": "number", "minimum": -4096, "maximum": 4096}
                  },
                  "offset": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "number", "minimum": -256, "maximum": 256}
                  },
                  "path": {"type": "string", "maxLength": 1024, "pattern": "^[MLHVCSAZ][MLHVCSAZeE0-9+., -]*$"},
                  "stroke": {"type": "number", "minimum": 0.1, "maximum": 6},
                  "color": {"$ref": "#/$defs/color"},
                  "states": {
                    "type": "object",
                    "propertyNames": {"$ref": "#/$defs/state"},
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "maxLength": 1024,
                          "pattern": "^[MLHVCSAZ][MLHVCSAZeE0-9+., -]*$"
                        },
                        "color": {"$ref": "#/$defs/color"}
                      }
                    }
                  }
                }
              },
              {"type": "null"}
            ]
          }
        },
        "displays": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/display"}
        },
        "transition": {
          "type": "object",
          "properties": {
            "duration": {"type": "number", "minimum": 0, "maximum": 1500},
            "easing": {"enum": ["linear", "ease", "ease-in", "ease-out", "ease-in-out"]}
          }
        }
      }
    },
    "state": {
      "enum": [
        "enabled",
        "hover",
        "pressed",
        "selected",
        "focus",
        "disabled",
        "bypassed",
        "automated",
        "modulated",
        "invalid",
        "warning"
      ]
    },
    "icon": {
      "type": "object",
      "required": ["name", "path"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "category": {"enum": ["module", "toolbar", "routing", "handle", "other"]},
        "keywords": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/name"}},
        "viewBox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number", "minimum": -4096, "maximum": 4096}
        },
        "offset": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "minimum": -256, "maximum": 256}
        },
        "path": {"type": "string", "maxLength": 1024, "pattern": "^[MLHVCSAZ][MLHVCSAZeE0-9+., -]*$"},
        "stroke": {"type": "number", "minimum": 0.1, "maximum": 6},
        "color": {"$ref": "#/$defs/color"},
        "states": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/state"},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {"type": "string", "maxLength": 1024, "pattern": "^[MLHVCSAZ][MLHVCSAZeE0-9+., -]*$"},
              "color": {"$ref": "#/$defs/color"}
            }
          }
        }
      }
    },
    "icons": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/icon"}
    },
    "display": {
      "type": "object",
      "properties": {
        "background": {"$ref": "#/$defs/color"},
        "major": {"$ref": "#/$defs/color"},
        "minor": {"$ref": "#/$defs/color"},
        "labels": {"$ref": "#/$defs/color"},
        "grid": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number", "minimum": 1, "maximum": 16}
        },
        "axes": {
          "type": "object",
          "properties": {
            "range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number", "minimum": -1000000000.0, "maximum": 1000000000.0}
            },
            "precision": {"type": "number", "minimum": 0, "maximum": 6},
            "unit": {"type": "string", "maxLength": 80}
          }
        },
        "traces": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "spectrum",
              "frequency-response",
              "transfer",
              "gain-reduction",
              "waveform",
              "meter-track",
              "meter-fill",
              "peak-hold",
              "handle",
              "selected-band",
              "mid",
              "side",
              "sidechain"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "required": ["color"],
            "properties": {
              "color": {"$ref": "#/$defs/color"},
              "width": {"type": "number", "minimum": 0.5, "maximum": 8},
              "mode": {"enum": ["line", "fill", "points"]}
            }
          }
        }
      }
    },
    "stackLayer": {
      "type": "object",
      "required": ["id", "material"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "material": {"$ref": "#/$defs/id"},
        "rect": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number", "minimum": -2, "maximum": 3}
        },
        "anchor": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "pivot": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "transform": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"type": "number", "minimum": -360, "maximum": 360}
        },
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "visible": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "state": {"$ref": "#/$defs/state"},
        "clip": {"type": "boolean"},
        "text": {"type": "string", "maxLength": 240},
        "motion": {
          "type": "object",
          "properties": {
            "source": {"enum": ["value", "indicator"]},
            "target": {"enum": ["rotate", "x", "y", "fill-x", "fill-y", "opacity"]},
            "range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number", "minimum": -360, "maximum": 360}
            }
          }
        },
        "frame": {
          "type": "object",
          "required": ["count"],
          "properties": {
            "count": {"type": "integer", "minimum": 2, "maximum": 128},
            "orientation": {"enum": ["horizontal", "vertical"]}
          }
        }
      }
    }
  }
}
