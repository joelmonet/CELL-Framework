@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/CellCompilerContract.cmake")
set(_cell_sdk_prefix "${PACKAGE_PREFIX_DIR}")
set(_cell_sdk_adapters "@PACKAGE_CELL_SDK_ADAPTER_DIR@")
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@CELL_SDK_NETWORK_AUTH@)
    find_dependency(OpenSSL 1.1.1 COMPONENTS Crypto)
endif()
if(@CELL_SDK_UI@)
    if(NOT TARGET blend2d::blend2d)
        find_dependency(blend2d CONFIG)
    endif()
    if(@CELL_SDK_NEEDS_X11@)
        if(@CELL_SDK_NEEDS_XI2@)
            find_dependency(X11 COMPONENTS Xi X11_xcb xcb)
        else()
            find_dependency(X11 COMPONENTS X11_xcb xcb)
        endif()
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CellTargets.cmake")
set(Cell_Core_FOUND TRUE)
set(Cell_AudioFiles_FOUND TRUE)
set(Cell_DSP_FOUND TRUE)
set(Cell_Graphics_FOUND TRUE)
set(Cell_WebView_FOUND @CELL_SDK_WEBVIEW@)
set(Cell_Wrappers_FOUND TRUE)
set(Cell_State_FOUND @CELL_SDK_STATE@)
set(Cell_StateTree_FOUND @CELL_SDK_STATE@)
set(Cell_LegacyState_FOUND @CELL_SDK_STATE@)
set(Cell_StateMigration_FOUND @CELL_SDK_STATE@)
set(Cell_UI_FOUND @CELL_SDK_UI@)
set(Cell_AudioDevice_FOUND @CELL_SDK_AUDIO_DEVICE@)
set(Cell_NetworkAudio_FOUND @CELL_SDK_NETWORK_AUTH@)
set(Cell_AndroidMidi_FOUND @CELL_SDK_ANDROID_MIDI@)
set(Cell_KSP_FOUND @CELL_SDK_KSP@)
set(Cell_ARASource_FOUND @CELL_SDK_ARA_SOURCE@)
if(Cell_ARASource_FOUND)
    find_path(CELL_ARA_SDK_PATH ARA_API/ARAInterface.h)
    if(CELL_ARA_SDK_PATH)
        set_property(TARGET Cell::ARASource APPEND PROPERTY
            INTERFACE_INCLUDE_DIRECTORIES "${CELL_ARA_SDK_PATH}")
    else()
        set(Cell_ARASource_FOUND FALSE)
    endif()
endif()
set(PACKAGE_PREFIX_DIR "${_cell_sdk_prefix}")
set_property(GLOBAL PROPERTY CELL_ADAPTER_SOURCE_DIR "${_cell_sdk_adapters}")
set_property(GLOBAL PROPERTY CELL_RESOURCE_EMBED_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/embed_resource.py")
include("${CMAKE_CURRENT_LIST_DIR}/CellAddPlugin.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CellWindowsVersion.cmake")
check_required_components(Cell)
