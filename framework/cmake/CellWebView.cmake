include_guard(GLOBAL)
function(cell_add_webview root)
    add_library(cell_webview STATIC "${root}/src/webview/webview.cpp")
    add_library(Cell::WebView ALIAS cell_webview)
    set_target_properties(cell_webview PROPERTIES EXPORT_NAME WebView POSITION_INDEPENDENT_CODE ON)
    cell_apply_compiler_contract(cell_webview)
    target_link_libraries(cell_webview PUBLIC cell_core PRIVATE ${CMAKE_DL_LIBS})
    if(WIN32)
        set(CELL_WEBVIEW2_INCLUDE_DIR "" CACHE PATH "Official Microsoft SDK directory containing WebView2.h")
        if(NOT EXISTS "${CELL_WEBVIEW2_INCLUDE_DIR}/WebView2.h")
            message(FATAL_ERROR "Cell::WebView on Windows requires CELL_WEBVIEW2_INCLUDE_DIR from Microsoft's WebView2 SDK")
        endif()
        include(CheckIncludeFileCXX)
        check_include_file_cxx(EventToken.h CELL_HAS_WINDOWS_EVENT_TOKEN)
        if(NOT CELL_HAS_WINDOWS_EVENT_TOKEN)
            target_include_directories(cell_webview PRIVATE "${root}/src/webview/compat")
        endif()
        target_include_directories(cell_webview SYSTEM PRIVATE "${CELL_WEBVIEW2_INCLUDE_DIR}")
        target_sources(cell_webview PRIVATE "${root}/src/webview/windows.cpp")
        target_link_libraries(cell_webview PRIVATE ole32 user32 uuid)
    elseif(APPLE)
        set_target_properties(cell_webview PROPERTIES OBJCXX_STANDARD 20 OBJCXX_STANDARD_REQUIRED ON OBJCXX_EXTENSIONS OFF)
        target_sources(cell_webview PRIVATE "${root}/src/webview/macos.mm")
        set_source_files_properties("${root}/src/webview/macos.mm" PROPERTIES COMPILE_FLAGS "-fno-objc-arc")
        target_link_libraries(cell_webview PRIVATE "-framework Cocoa" "-framework WebKit")
    else()
        target_sources(cell_webview PRIVATE "${root}/src/webview/linux.cpp")
    endif()
    if(NOT CELL_SDK_UI)
        include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CellNativeServices.cmake")
        cell_add_native_file_dialog(cell_webview "${root}")
    endif()
endfunction()
