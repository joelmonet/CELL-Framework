include_guard(GLOBAL)

function(_cell_plugin_arguments prefix)
    cmake_parse_arguments(P "UI;AU_EDITOR_METERS" "PROCESSOR;ID;NAME;CLAP_SDK;VST3_PROCESSOR_UID;VST3_CONTROLLER_UID;VST2_SDK;VST2_ID;VERSION_CODE;VERSION;COMPANY;CATEGORIES;AAX_SDK;AAX_LIBRARY;AAX_MANUFACTURER_ID;AAX_PRODUCT_ID;AAX_MONO_ID;AAX_STEREO_ID;AAX_CHUNK_ID;AU_SDK;AU_TYPE;AU_SUBTYPE;AU_MANUFACTURER;AU_EDITOR_HTML;AU_EDITOR_BINDINGS" "AU_EDITOR_PARAMETERS" ${ARGN})
    if(P_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "Unknown Cell plugin arguments: ${P_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT P_PROCESSOR OR NOT TARGET "${P_PROCESSOR}")
        message(FATAL_ERROR "Cell plugin needs an existing PROCESSOR library target")
    endif()
    if(NOT P_ID MATCHES "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$")
        message(FATAL_ERROR "Cell plugin needs a stable reverse-domain ID")
    endif()
    if(NOT P_NAME)
        message(FATAL_ERROR "Cell plugin needs NAME")
    endif()
    if(P_UI AND NOT TARGET Cell::UI)
        message(FATAL_ERROR "A UI-enabled Cell plugin needs the Cell UI component")
    endif()
    set(au_editor_options AU_EDITOR_HTML AU_EDITOR_BINDINGS AU_EDITOR_PARAMETERS AU_EDITOR_METERS)
    foreach(option IN LISTS au_editor_options)
        if(option IN_LIST P_KEYWORDS_MISSING_VALUES)
            message(FATAL_ERROR "${option} requires a value")
        endif()
        if(DEFINED P_${option} AND (NOT option STREQUAL "AU_EDITOR_METERS" OR P_AU_EDITOR_METERS)
           AND NOT (cell_parsing_auv3 OR cell_parsing_auv2))
            message(FATAL_ERROR "${option} is specific to Cell Audio Unit targets")
        endif()
    endforeach()
    if(cell_parsing_auv2 AND (P_AU_EDITOR_PARAMETERS OR
       (P_AU_EDITOR_HTML AND NOT P_AU_EDITOR_BINDINGS)))
        message(FATAL_ERROR "Cell AUv2 requires paired AU_EDITOR_HTML and AU_EDITOR_BINDINGS exports")
    endif()
    if(P_AU_EDITOR_BINDINGS AND P_AU_EDITOR_PARAMETERS)
        message(FATAL_ERROR "Choose either AU_EDITOR_BINDINGS or AU_EDITOR_PARAMETERS")
    endif()
    if((P_AU_EDITOR_HTML AND NOT (P_AU_EDITOR_BINDINGS OR P_AU_EDITOR_PARAMETERS OR P_AU_EDITOR_METERS)) OR
       ((P_AU_EDITOR_BINDINGS OR P_AU_EDITOR_PARAMETERS OR P_AU_EDITOR_METERS) AND NOT P_AU_EDITOR_HTML))
        message(FATAL_ERROR "Cell AUv3 requires AU_EDITOR_HTML with AU_EDITOR_BINDINGS, AU_EDITOR_PARAMETERS or AU_EDITOR_METERS")
    endif()
    foreach(key IN ITEMS UI PROCESSOR ID NAME CLAP_SDK VST3_PROCESSOR_UID VST3_CONTROLLER_UID VST2_SDK VST2_ID VERSION_CODE VERSION COMPANY CATEGORIES AAX_SDK AAX_LIBRARY AAX_MANUFACTURER_ID AAX_PRODUCT_ID AAX_MONO_ID AAX_STEREO_ID AAX_CHUNK_ID AU_SDK AU_TYPE AU_SUBTYPE AU_MANUFACTURER ${au_editor_options})
        set("${prefix}_${key}" "${P_${key}}" PARENT_SCOPE)
    endforeach()
endfunction()

function(_cell_au_plist output target template)
    foreach(code IN ITEMS AU_SUBTYPE AU_MANUFACTURER)
        if(NOT P_${code} MATCHES "^[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]$")
            message(FATAL_ERROR "${code} must be a stable four-character Audio Unit code")
        endif()
    endforeach()
    if(NOT P_COMPANY)
        message(FATAL_ERROR "Cell AU needs COMPANY for the component display name")
    endif()
    if(NOT P_VERSION)
        set(P_VERSION "0.1.0")
    endif()
    if(NOT P_VERSION_CODE)
        set(P_VERSION_CODE 256)
    endif()
    if(NOT P_VERSION MATCHES "^[0-9]+[.][0-9]+[.][0-9]+$" OR
       NOT P_VERSION_CODE MATCHES "^[1-9][0-9]*$" OR P_VERSION_CODE GREATER 16777215)
        message(FATAL_ERROR "Cell AU needs a three-part VERSION and a positive 24-bit decimal VERSION_CODE")
    endif()
    foreach(key IN ITEMS NAME COMPANY)
        string(REPLACE "&" "&amp;" CELL_AU_${key} "${P_${key}}")
        string(REPLACE "<" "&lt;" CELL_AU_${key} "${CELL_AU_${key}}")
        string(REPLACE ">" "&gt;" CELL_AU_${key} "${CELL_AU_${key}}")
    endforeach()
    set(plist "${CMAKE_CURRENT_BINARY_DIR}/${target}-Info.plist")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/${template}" "${plist}" @ONLY)
    set(${output} "${plist}" PARENT_SCOPE)
endfunction()

function(cell_add_au_plugin target)
    set(cell_parsing_auv2 ON)
    _cell_plugin_arguments(P ${ARGN})
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Darwin" OR P_UI)
        message(FATAL_ERROR "Cell AUv2 requires macOS. Use AU_EDITOR_HTML and AU_EDITOR_BINDINGS for a custom editor")
    endif()
    if(P_AU_TYPE AND NOT P_AU_TYPE STREQUAL "aufx")
        message(FATAL_ERROR "Cell AUv2 supports AU_TYPE aufx")
    endif()
    if(NOT EXISTS "${P_AU_SDK}/include/AudioUnitSDK/AUEffectBase.h")
        message(FATAL_ERROR "Set AU_SDK to Apple's AudioUnitSDK 1.4.0 checkout")
    endif()
    _cell_au_plist(plist "${target}" CellAUInfo.plist.in)
    set(au_sdk_sources)
    foreach(source IN ITEMS AUBase AUBuffer AUBufferAllocator AUEffectBase AUInputElement AUOutputElement
                            AUPlugInDispatch AUScopeElement ComponentBase)
        list(APPEND au_sdk_sources "${P_AU_SDK}/src/AudioUnitSDK/${source}.cpp")
    endforeach()
    get_property(adapters GLOBAL PROPERTY CELL_ADAPTER_SOURCE_DIR)
    add_library(${target} MODULE "${adapters}/au.cpp" ${au_sdk_sources})
    target_include_directories(${target} PRIVATE "${P_AU_SDK}/include")
    target_compile_features(${target} PRIVATE cxx_std_23)
    target_compile_definitions(${target} PRIVATE AUSDK_HAVE_UI=0 AUSDK_HAVE_MIDI=0
        AUSDK_HAVE_MUSIC_DEVICE=0 AUSDK_HAVE_IO_UNITS=0)
    target_link_libraries(${target} PRIVATE "${P_PROCESSOR}" "-framework AudioToolbox" "-framework CoreFoundation")
    set_target_properties(${target} PROPERTIES PREFIX "" OUTPUT_NAME "${P_NAME}"
        BUNDLE TRUE BUNDLE_EXTENSION component MACOSX_BUNDLE_INFO_PLIST "${plist}"
        CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
    if(P_AU_EDITOR_HTML)
        if(NOT TARGET Cell::WebView OR NOT CMAKE_OBJCXX_COMPILER_LOADED)
            message(FATAL_ERROR "The AUv2 designer editor requires Cell::WebView and OBJCXX")
        endif()
        string(SHA256 class_digest "${P_ID}")
        string(SUBSTRING "${class_digest}" 0 16 class_suffix)
        target_sources(${target} PRIVATE "${adapters}/au_editor.mm")
        target_compile_definitions(${target} PRIVATE "CellAUViewFactory=CellAUViewFactory_${class_suffix}"
            "CellAUView=CellAUView_${class_suffix}")
        if(P_AU_EDITOR_METERS)
            target_compile_definitions(${target} PRIVATE CELL_AU_EDITOR_METERS)
        endif()
        set_target_properties(${target} PROPERTIES OBJCXX_STANDARD 20
            OBJCXX_STANDARD_REQUIRED ON OBJCXX_EXTENSIONS OFF)
        target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>")
        _cell_embed_designer_editor(${target} AU "${P_AU_EDITOR_HTML}" "${P_AU_EDITOR_BINDINGS}")
    endif()
endfunction()

function(cell_add_auv3_plugin target)
    set(cell_parsing_auv3 ON)
    _cell_plugin_arguments(P ${ARGN})
    if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Darwin|iOS)$" OR P_UI OR NOT CMAKE_OBJCXX_COMPILER_LOADED)
        message(FATAL_ERROR "Cell AUv3 requires macOS or iOS with OBJCXX enabled. Use AU_EDITOR_HTML for a custom editor")
    endif()
    if(P_AU_TYPE STREQUAL "")
        set(P_AU_TYPE aufx)
    elseif(NOT P_AU_TYPE MATCHES "^(aufx|aumf|aumi|aumu)$")
        message(FATAL_ERROR "Cell AUv3 requires AU_TYPE aufx, aumf, aumi or aumu")
    endif()
    if(P_AU_TYPE STREQUAL "aumi")
        set(CELL_AUV3_CATEGORY MIDI)
    elseif(P_AU_TYPE STREQUAL "aumu")
        set(CELL_AUV3_CATEGORY Synthesizer)
    else()
        set(CELL_AUV3_CATEGORY Effects)
    endif()
    # A host can load several Cell extensions into the same Objective-C runtime.
    string(SHA256 class_digest "${P_ID}")
    string(SUBSTRING "${class_digest}" 0 16 class_suffix)
    set(CELL_AUV3_EXTENSION_POINT com.apple.AudioUnit)
    set(CELL_AUV3_PRINCIPAL_CLASS "CellAUv3Factory_${class_suffix}")
    set(CELL_AUV3_EDITOR_PLIST "")
    if(P_AU_EDITOR_HTML)
        cmake_path(ABSOLUTE_PATH P_AU_EDITOR_HTML NORMALIZE)
        if(NOT EXISTS "${P_AU_EDITOR_HTML}" OR IS_DIRECTORY "${P_AU_EDITOR_HTML}")
            message(FATAL_ERROR "Cell AUv3 editor HTML could not be found: ${P_AU_EDITOR_HTML}")
        endif()
        file(SIZE "${P_AU_EDITOR_HTML}" editor_bytes)
        if(editor_bytes LESS 1 OR editor_bytes GREATER 8388608)
            message(FATAL_ERROR "Cell AUv3 editor HTML must be between 1 byte and 8 MiB")
        endif()
        set(editor_keys ${P_AU_EDITOR_PARAMETERS})
        list(LENGTH editor_keys editor_count)
        list(REMOVE_DUPLICATES editor_keys)
        list(LENGTH editor_keys unique_count)
        if(editor_count GREATER 128 OR NOT editor_count EQUAL unique_count)
            message(FATAL_ERROR "Use up to 128 distinct AU_EDITOR_PARAMETERS keys")
        endif()
        set(CELL_AUV3_EXTENSION_POINT com.apple.AudioUnit-UI)
        set(CELL_AUV3_PRINCIPAL_CLASS "CellAUv3Editor_${class_suffix}")
        if(NOT P_AU_EDITOR_BINDINGS)
            set(CELL_AUV3_EDITOR_PLIST "<key>CellEditorParameters</key><array>")
            foreach(key IN LISTS editor_keys)
                string(REPLACE "&" "&amp;" key "${key}")
                string(REPLACE "<" "&lt;" key "${key}")
                string(REPLACE ">" "&gt;" key "${key}")
                string(APPEND CELL_AUV3_EDITOR_PLIST "<string>${key}</string>")
            endforeach()
            string(APPEND CELL_AUV3_EDITOR_PLIST "</array>")
        endif()
    endif()
    _cell_au_plist(plist "${target}" CellAUv3Info.plist.in)
    get_property(adapters GLOBAL PROPERTY CELL_ADAPTER_SOURCE_DIR)
    add_executable(${target} MACOSX_BUNDLE "${adapters}/auv3.mm")
    target_compile_definitions(${target} PRIVATE
        "CellAUv3Effect=CellAUv3Effect_${class_suffix}" "CellAUv3MainBus=CellAUv3MainBus_${class_suffix}"
        "CellAUv3Factory=CellAUv3Factory_${class_suffix}")
    if(P_AU_EDITOR_HTML)
        set(editor_dir "${CMAKE_CURRENT_BINARY_DIR}/${target}-editor")
        set(editor_resource "${editor_dir}/CellEditor.html")
        configure_file("${P_AU_EDITOR_HTML}" "${editor_resource}" COPYONLY)
        set_source_files_properties("${editor_resource}" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
        target_sources(${target} PRIVATE "${adapters}/auv3_editor.mm" "${editor_resource}")
        target_compile_definitions(${target} PRIVATE CELL_AUV3_CUSTOM_EDITOR
            "CellAUv3Editor=${CELL_AUV3_PRINCIPAL_CLASS}" "CellAUv3MessageHandler=CellAUv3MessageHandler_${class_suffix}")
        if(P_AU_EDITOR_BINDINGS)
            cmake_path(ABSOLUTE_PATH P_AU_EDITOR_BINDINGS NORMALIZE)
            if(NOT EXISTS "${P_AU_EDITOR_BINDINGS}" OR IS_DIRECTORY "${P_AU_EDITOR_BINDINGS}")
                message(FATAL_ERROR "Cell AUv3 editor bindings could not be found: ${P_AU_EDITOR_BINDINGS}")
            endif()
            configure_file("${P_AU_EDITOR_BINDINGS}" "${editor_dir}/cell_auv3_web_bindings.hpp" COPYONLY)
            target_include_directories(${target} PRIVATE "${editor_dir}")
            target_compile_definitions(${target} PRIVATE CELL_AUV3_DESIGNER_BINDINGS)
        endif()
        if(P_AU_EDITOR_METERS)
            target_compile_definitions(${target} PRIVATE CELL_AUV3_EDITOR_METERS)
        endif()
        target_link_libraries(${target} PRIVATE "-framework CoreAudioKit" "-framework WebKit")
        if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
            target_link_libraries(${target} PRIVATE "-framework AppKit")
        else()
            target_link_libraries(${target} PRIVATE "-framework UIKit")
        endif()
        set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${editor_resource}")
    else()
        if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
            set(resource_dir "$<TARGET_BUNDLE_CONTENT_DIR:${target}>/Resources")
        else()
            set(resource_dir "$<TARGET_BUNDLE_CONTENT_DIR:${target}>")
        endif()
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND "${CMAKE_COMMAND}" -E rm -f "${resource_dir}/CellEditor.html"
            VERBATIM)
    endif()
    set_target_properties(${target} PROPERTIES
        OUTPUT_NAME "${P_NAME}" BUNDLE_EXTENSION appex
        MACOSX_BUNDLE_INFO_PLIST "${plist}" MACOSX_BUNDLE_GUI_IDENTIFIER "${P_ID}"
        MACOSX_BUNDLE_BUNDLE_VERSION 1
        OBJCXX_STANDARD 20 OBJCXX_STANDARD_REQUIRED ON OBJCXX_EXTENSIONS OFF
        XCODE_PRODUCT_TYPE com.apple.product-type.app-extension
        XCODE_EXPLICIT_FILE_TYPE wrapper.app-extension
        XCODE_ATTRIBUTE_PRODUCT_BUNDLE_IDENTIFIER "${P_ID}"
        XCODE_ATTRIBUTE_APPLICATION_EXTENSION_API_ONLY YES
        XCODE_ATTRIBUTE_SKIP_INSTALL YES)
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        set_target_properties(${target} PROPERTIES
            XCODE_ATTRIBUTE_CODE_SIGN_ENTITLEMENTS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CellAUv3MacSandbox.entitlements")
    endif()
    target_compile_options(${target} PRIVATE -fobjc-arc -fapplication-extension)
    target_link_options(${target} PRIVATE "LINKER:-e,_NSExtensionMain" "LINKER:-application_extension")
    target_link_libraries(${target} PRIVATE "${P_PROCESSOR}" Cell::Core
        "-framework Foundation" "-framework AudioToolbox" "-framework AVFoundation")
endfunction()

function(cell_embed_auv3_extensions app)
    add_dependencies(${app} ${ARGN})
    if(CMAKE_GENERATOR STREQUAL "Xcode")
        set_target_properties(${app} PROPERTIES XCODE_EMBED_APP_EXTENSIONS "${ARGN}"
            XCODE_EMBED_APP_EXTENSIONS_CODE_SIGN_ON_COPY ON)
    else()
        foreach(extension IN LISTS ARGN)
            set_property(TARGET ${app} APPEND PROPERTY LINK_DEPENDS
                "$<TARGET_FILE:${extension}>" "$<TARGET_BUNDLE_CONTENT_DIR:${extension}>/Info.plist")
            add_custom_command(TARGET ${app} POST_BUILD
                COMMAND "${CMAKE_COMMAND}" -E make_directory "$<TARGET_BUNDLE_CONTENT_DIR:${app}>/PlugIns"
                COMMAND "${CMAKE_COMMAND}" -E rm -rf
                    "$<TARGET_BUNDLE_CONTENT_DIR:${app}>/PlugIns/$<TARGET_BUNDLE_DIR_NAME:${extension}>"
                COMMAND "${CMAKE_COMMAND}" -E copy_directory "$<TARGET_BUNDLE_DIR:${extension}>"
                    "$<TARGET_BUNDLE_CONTENT_DIR:${app}>/PlugIns/$<TARGET_BUNDLE_DIR_NAME:${extension}>"
                VERBATIM)
        endforeach()
    endif()
endfunction()

# Keep the upstream SDK external. Both the native builder and the optional
# Linux link probe compile the SDK's ordinary sources as separate units.
function(_cell_add_aax_sdk_sources target sdk pool_source)
    set(library "${sdk}/Libs/AAXLibrary")
    set(include_dir "${library}/include")
    if(NOT IS_DIRECTORY "${include_dir}")
        set(include_dir "${library}/Include")
    endif()
    if(NOT IS_DIRECTORY "${include_dir}" OR
       NOT EXISTS "${library}/source/AAX_Init.cpp" OR
       NOT EXISTS "${sdk}/Interfaces/ACF/CACFClassFactory.cpp" OR NOT EXISTS "${pool_source}")
        message(FATAL_ERROR "AAX_SDK must contain the Avid AAXLibrary sources, headers and ACF factory")
    endif()
    file(GLOB sources CONFIGURE_DEPENDS "${library}/source/AAX_*.cpp")
    list(FILTER sources EXCLUDE REGEX "[.]([Ww][Ii][Nn]|[Oo][Ss][Xx])[.]cpp$")
    add_library(${target} STATIC ${sources} "${pool_source}"
        "${sdk}/Interfaces/ACF/CACFClassFactory.cpp")
    target_include_directories(${target} PRIVATE "${include_dir}"
        "${sdk}/Interfaces" "${sdk}/Interfaces/ACF")
    set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON
        CXX_STANDARD 14 CXX_STANDARD_REQUIRED ON
        CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
endfunction()

function(cell_add_aax_sdk_library target sdk)
    if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
        if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND
           NOT CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC")
            message(FATAL_ERROR "The Windows Avid AAXLibrary requires an MSVC-compatible compiler")
        endif()
        _cell_add_aax_sdk_sources(${target} "${sdk}" "${sdk}/Libs/AAXLibrary/source/AAX_CAutoreleasePool.Win.cpp")
        target_compile_definitions(${target} PRIVATE _WINDOWS I18N_LIB PLUGIN_SDK_BUILD
            _CRT_SECURE_NO_DEPRECATE _SCL_SECURE_NO_DEPRECATE AAX_PLUGIN_BUILD)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        if(NOT CMAKE_OBJCXX_COMPILER_LOADED)
            message(FATAL_ERROR "Enable OBJCXX in the calling CMake directory before building AAXLibrary on macOS")
        endif()
        _cell_add_aax_sdk_sources(${target} "${sdk}" "${sdk}/Libs/AAXLibrary/source/AAX_CAutoreleasePool.OSX.mm")
        target_compile_definitions(${target} PRIVATE UNICODE=1 "$<$<CONFIG:Debug>:_DEBUG=1>")
        target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fno-objc-arc>")
        target_link_libraries(${target} PRIVATE "-framework Foundation")
    else()
        message(FATAL_ERROR "Building AAXLibrary for a Native plug-in requires macOS or Windows")
    endif()
endfunction()

function(_cell_add_aax_adapter target)
    get_property(adapters GLOBAL PROPERTY CELL_ADAPTER_SOURCE_DIR)
    add_library(${target} MODULE "${adapters}/aax.cpp" "${P_AAX_SDK}/Interfaces/AAX_Exports.cpp")
    target_link_libraries(${target} PRIVATE "${P_PROCESSOR}" Cell::Wrappers "${P_AAX_LIBRARY}")
    if(P_UI)
        target_link_libraries(${target} PRIVATE Cell::UI)
    endif()
    target_include_directories(${target} PRIVATE "${P_AAX_SDK}/Interfaces" "${P_AAX_SDK}/Interfaces/ACF")
    target_compile_definitions(${target} PRIVATE "CELL_HAS_UI=$<BOOL:${P_UI}>" "CELL_PLUGIN_VERSION_CODE=${P_VERSION_CODE}")
    foreach(key IN ITEMS AAX_MANUFACTURER_ID AAX_PRODUCT_ID AAX_MONO_ID AAX_STEREO_ID AAX_CHUNK_ID)
        target_compile_definitions(${target} PRIVATE "CELL_${key}=${P_${key}}")
    endforeach()
endfunction()

function(cell_add_aax_plugin target)
    _cell_plugin_arguments(P ${ARGN})
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND NOT CMAKE_SYSTEM_NAME STREQUAL "Windows")
        message(FATAL_ERROR "AAX Native requires a supported macOS or Windows host platform")
    endif()
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "The Cell AAX Native adapter requires a 64-bit SDK/library")
    endif()
    if(NOT EXISTS "${P_AAX_SDK}/Interfaces/AAX.h" OR NOT EXISTS "${P_AAX_SDK}/Interfaces/AAX_Exports.cpp")
        message(FATAL_ERROR "AAX_SDK must point to the actual, separately supplied Avid SDK")
    endif()
    if(P_AAX_LIBRARY AND NOT TARGET "${P_AAX_LIBRARY}")
        message(FATAL_ERROR "AAX_LIBRARY must name an existing target for the matching Avid AAXLibrary")
    endif()
    foreach(key IN ITEMS AAX_MANUFACTURER_ID AAX_PRODUCT_ID AAX_MONO_ID AAX_STEREO_ID AAX_CHUNK_ID)
        if(NOT P_${key} MATCHES "^0x[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]$" OR P_${key} STREQUAL "0x00000000")
            message(FATAL_ERROR "${key} requires an explicit, nonzero, eight-digit hexadecimal identity")
        endif()
    endforeach()
    string(TOLOWER "${P_AAX_MONO_ID}" mono)
    string(TOLOWER "${P_AAX_STEREO_ID}" stereo)
    if(mono STREQUAL stereo)
        message(FATAL_ERROR "AAX_MONO_ID and AAX_STEREO_ID must be distinct")
    endif()
    if(NOT P_VERSION_CODE)
        set(P_VERSION_CODE 10000)
    endif()
    if(NOT P_VERSION_CODE MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "VERSION_CODE must be a positive integer")
    endif()
    if(NOT P_VERSION)
        set(P_VERSION "0.1.0")
    endif()
    if(NOT P_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
        message(FATAL_ERROR "VERSION must have three numeric components")
    endif()
    if(NOT P_AAX_LIBRARY)
        set(P_AAX_LIBRARY "${target}_sdk")
        cell_add_aax_sdk_library("${P_AAX_LIBRARY}" "${P_AAX_SDK}")
    endif()
    _cell_add_aax_adapter(${target})
    set_target_properties(${target} PROPERTIES PREFIX "" OUTPUT_NAME "${P_NAME}")
    if(APPLE)
        set(CELL_AAX_NAME "${P_NAME}")
        string(REPLACE "&" "&amp;" CELL_AAX_NAME "${CELL_AAX_NAME}")
        string(REPLACE "<" "&lt;" CELL_AAX_NAME "${CELL_AAX_NAME}")
        string(REPLACE ">" "&gt;" CELL_AAX_NAME "${CELL_AAX_NAME}")
        set(CELL_AAX_ID "${P_ID}")
        set(CELL_AAX_VERSION "${P_VERSION}")
        set(CELL_AAX_VERSION_CODE "${P_VERSION_CODE}")
        set(plist "${CMAKE_CURRENT_BINARY_DIR}/${target}-Info.plist")
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CellAAXInfo.plist.in" "${plist}" @ONLY)
        set_target_properties(${target} PROPERTIES BUNDLE TRUE BUNDLE_EXTENSION aaxplugin MACOSX_BUNDLE_INFO_PLIST "${plist}")
        target_link_libraries(${target} PRIVATE "-framework CoreFoundation" "-framework Foundation")
    else()
        if(CMAKE_GENERATOR_PLATFORM MATCHES "[Aa][Rr][Mm]" OR CMAKE_SYSTEM_PROCESSOR MATCHES "[Aa][Rr][Mm]")
            message(FATAL_ERROR "The current Windows AAX packaging path targets x64")
        endif()
        set(bundle "${CMAKE_CURRENT_BINARY_DIR}/aax/$<CONFIG>/${P_NAME}.aaxplugin/Contents/x64")
        set_target_properties(${target} PROPERTIES SUFFIX .aaxplugin RUNTIME_OUTPUT_DIRECTORY "${bundle}" LIBRARY_OUTPUT_DIRECTORY "${bundle}")
    endif()
    # SDK licensing, signing and host qualification are external release steps.
    # This helper never installs into a host or invokes a signing service.
endfunction()

function(_cell_configure_plugin_bundle target id name)
    string(REPLACE "&" "&amp;" bundle_name "${name}")
    string(REPLACE "<" "&lt;" bundle_name "${bundle_name}")
    string(REPLACE ">" "&gt;" bundle_name "${bundle_name}")
    set(plist "${CMAKE_CURRENT_BINARY_DIR}/${target}-Info.plist")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CellPluginBundleInfo.plist.in" "${plist}" @ONLY)
    set_target_properties(${target} PROPERTIES
        MACOSX_BUNDLE_GUI_IDENTIFIER "${id}" MACOSX_BUNDLE_INFO_PLIST "${plist}")
endfunction()

function(_cell_embed_designer_resources target format html bindings)
    cmake_path(ABSOLUTE_PATH html NORMALIZE)
    cmake_path(ABSOLUTE_PATH bindings NORMALIZE)
    foreach(asset IN ITEMS "${html}" "${bindings}")
        if(NOT EXISTS "${asset}" OR IS_DIRECTORY "${asset}")
            message(FATAL_ERROR "${format} designer export could not be found: ${asset}")
        endif()
    endforeach()
    file(SIZE "${html}" editor_size)
    if(editor_size LESS 1 OR editor_size GREATER 8388608)
        message(FATAL_ERROR "${format}_EDITOR_HTML must be between 1 byte and 8 MiB")
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    get_property(embed GLOBAL PROPERTY CELL_RESOURCE_EMBED_SCRIPT)
    string(TOLOWER "${format}" format_lower)
    set(editor_dir "${CMAKE_CURRENT_BINARY_DIR}/${target}-editor")
    set(page "${editor_dir}/cell_${format_lower}_web_page.hpp")
    configure_file("${bindings}" "${editor_dir}/cell_${format_lower}_web_bindings.hpp" COPYONLY)
    add_custom_command(OUTPUT "${page}"
        COMMAND "${Python3_EXECUTABLE}" "${embed}" "${html}" "${page}" --symbol "${format_lower}EditorPage"
        DEPENDS "${embed}" "${html}" VERBATIM)
    target_sources(${target} PRIVATE "${page}")
    target_include_directories(${target} PRIVATE "${editor_dir}")
endfunction()

function(_cell_embed_designer_editor target format html bindings)
    _cell_embed_designer_resources(${target} "${format}" "${html}" "${bindings}")
    target_compile_definitions(${target} PRIVATE "CELL_${format}_WEB_EDITOR=1")
    target_link_libraries(${target} PRIVATE Cell::WebView)
endfunction()

