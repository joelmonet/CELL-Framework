        target_link_libraries(${target} PRIVATE Cell::UI)
    endif()
    if(DEFINED WEB_CLAP_EDITOR_HTML)
        if(NOT TARGET Cell::WebView OR NOT (WIN32 OR CMAKE_SYSTEM_NAME MATCHES "^(Darwin|Linux)$"))
            message(FATAL_ERROR "The CLAP designer editor requires macOS, Windows, or Linux X11 with Cell::WebView")
        endif()
        if(P_UI)
            message(FATAL_ERROR "Choose either UI or CLAP_EDITOR_HTML for this CLAP plug-in")
        endif()
        _cell_embed_designer_editor(${target} CLAP "${WEB_CLAP_EDITOR_HTML}" "${WEB_CLAP_EDITOR_BINDINGS}")
