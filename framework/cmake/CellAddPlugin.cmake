    endif()
    if(APPLE)
        set_target_properties(${target} PROPERTIES BUNDLE TRUE BUNDLE_EXTENSION clap)
        _cell_configure_plugin_bundle(${target} "${P_ID}" "${P_NAME}")
    endif()
endfunction()

function(_cell_vst3_uid out id role explicit)
    if(explicit)
        string(LENGTH "${explicit}" length)
        if(NOT length EQUAL 32 OR NOT explicit MATCHES "^[0-9A-Fa-f]+$" OR explicit STREQUAL "00000000000000000000000000000000")
            message(FATAL_ERROR "VST3 ${role} UID needs exactly 32 hexadecimal digits in SDK FUID four-word order")
        endif()
        set(digest "${explicit}")
    else()
        string(SHA256 digest "${id}/${role}")
    endif()
    set(parts)
    foreach(offset IN ITEMS 0 8 16 24)
        string(SUBSTRING "${digest}" ${offset} 8 part)
        list(APPEND parts "0x${part}")
    endforeach()
    list(JOIN parts "," value)
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(cell_add_vst3_plugin target)
    cmake_parse_arguments(PARSE_ARGV 1 WEB "" "VST3_EDITOR_HTML;VST3_EDITOR_BINDINGS" "")
    _cell_plugin_arguments(P ${WEB_UNPARSED_ARGUMENTS})
    if(WEB_KEYWORDS_MISSING_VALUES OR (DEFINED WEB_VST3_EDITOR_HTML AND NOT DEFINED WEB_VST3_EDITOR_BINDINGS)
       OR (DEFINED WEB_VST3_EDITOR_BINDINGS AND NOT DEFINED WEB_VST3_EDITOR_HTML))
        message(FATAL_ERROR "Set VST3_EDITOR_HTML and VST3_EDITOR_BINDINGS together")
    endif()
    if(DEFINED WEB_VST3_EDITOR_HTML)
        if(NOT TARGET Cell::WebView OR NOT (WIN32 OR CMAKE_SYSTEM_NAME MATCHES "^(Darwin|Linux)$"))
            message(FATAL_ERROR "The VST3 designer editor requires macOS, Windows, or Linux X11 with Cell::WebView")
        endif()
        if(P_UI)
            message(FATAL_ERROR "Choose either UI or VST3_EDITOR_HTML for this VST3 plug-in")
        endif()
    endif()
    if(NOT TARGET sdk OR NOT COMMAND smtg_add_vst3plugin)
        message(FATAL_ERROR "Add the official VST3 SDK before calling cell_add_vst3_plugin")
    endif()
    if(NOT P_CATEGORIES)
        set(P_CATEGORIES "Fx|Tools")
    endif()
    if((P_VST3_PROCESSOR_UID AND NOT P_VST3_CONTROLLER_UID) OR (P_VST3_CONTROLLER_UID AND NOT P_VST3_PROCESSOR_UID))
        message(FATAL_ERROR "Supply both VST3_PROCESSOR_UID and VST3_CONTROLLER_UID when preserving existing identities")
    endif()
    _cell_vst3_uid(processor "${P_ID}" processor "${P_VST3_PROCESSOR_UID}")
    _cell_vst3_uid(controller "${P_ID}" controller "${P_VST3_CONTROLLER_UID}")
    string(TOLOWER "${processor}" processorCompare)
    string(TOLOWER "${controller}" controllerCompare)
    if(processorCompare STREQUAL controllerCompare)
        message(FATAL_ERROR "VST3 processor/controller UIDs must be distinct")
    endif()
    # Steinberg variables live in its add_subdirectory() scope. Resolve the
    # official SDK's source directory locally when called by an outside consumer;
    # otherwise smtg_target_add_library_main silently omits the platform entry.
    if(NOT public_sdk_SOURCE_DIR)
        get_target_property(_cell_sdk_directory sdk SOURCE_DIR)
        get_directory_property(public_sdk_SOURCE_DIR DIRECTORY "${_cell_sdk_directory}"
            DEFINITION public_sdk_SOURCE_DIR)
        if(NOT EXISTS "${public_sdk_SOURCE_DIR}/source/main/linuxmain.cpp")
            message(FATAL_ERROR "Cannot resolve the official VST3 SDK platform entry sources")
        endif()
    endif()
    get_property(adapters GLOBAL PROPERTY CELL_ADAPTER_SOURCE_DIR)
    # Steinberg's Linux packager uses CMAKE_BUILD_TYPE in the bundle path.
    # A generator expression lets each multi-config build use that config
    # without CMake appending another directory below the VST3 architecture.
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_CONFIGURATION_TYPES)
        set(CMAKE_BUILD_TYPE "$<CONFIG>")
    endif()
    smtg_add_vst3plugin(${target} PACKAGE_NAME "${P_NAME}" SOURCES_LIST "${adapters}/vst3.cpp")
    # Steinberg's Linux bundle path can reflect the build host's uname.
    # Override the library location using the target architecture on Pi.
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_CROSSCOMPILING AND
       CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
        get_target_property(_cell_vst3_bundle ${target} SMTG_PLUGIN_PACKAGE_PATH)
        set_target_properties(${target} PROPERTIES
            LIBRARY_OUTPUT_DIRECTORY "${_cell_vst3_bundle}/Contents/aarch64-linux")
    endif()
    target_link_libraries(${target} PRIVATE "${P_PROCESSOR}" sdk)
    if(P_UI)
        target_link_libraries(${target} PRIVATE Cell::UI)
    endif()
    if(DEFINED WEB_VST3_EDITOR_HTML)
        _cell_embed_designer_editor(${target} VST3 "${WEB_VST3_EDITOR_HTML}" "${WEB_VST3_EDITOR_BINDINGS}")
        if(WIN32)
            target_compile_definitions(${target} PRIVATE "CELL_VST3_WEB_PROFILE_ID=\"${P_ID}\"")
            target_link_libraries(${target} PRIVATE shell32 user32)
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
            target_link_libraries(${target} PRIVATE "-framework CoreFoundation")
        endif()
    endif()
    target_compile_definitions(${target} PRIVATE "CELL_HAS_UI=$<BOOL:${P_UI}>"
        "CELL_VST3_PROCESSOR_ID=${processor}" "CELL_VST3_CONTROLLER_ID=${controller}"
        "CELL_VST3_CONTROLLER_NAME=\"${P_NAME} Controller\"" "CELL_VST3_SUBCATEGORIES=\"${P_CATEGORIES}\"")
    get_target_property(_cell_sdk_source sdk SOURCE_DIR)
    if(EXISTS "${_cell_sdk_source}/source/main/linuxmain.cpp")
        set(public_sdk_SOURCE_DIR "${_cell_sdk_source}")
    elseif(EXISTS "${_cell_sdk_source}/public.sdk/source/main/linuxmain.cpp")
        set(public_sdk_SOURCE_DIR "${_cell_sdk_source}/public.sdk")
    else()
        message(FATAL_ERROR "The official VST3 platform entry sources are missing")
    endif()
    if(COMMAND smtg_target_add_library_main)
        smtg_target_add_library_main(${target})
    else()
        smtg_add_library_main(${target})
    endif()
    set_target_properties(${target} PROPERTIES OUTPUT_NAME "${P_NAME}"
        CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
    if(UNIX AND NOT APPLE)
        target_link_options(${target} PRIVATE "-Wl,--exclude-libs,ALL")
    endif()
    if(APPLE)
        smtg_target_set_bundle(${target} BUNDLE_IDENTIFIER "${P_ID}" COMPANY_NAME "${P_COMPANY}")
        if(NOT XCODE)
            _cell_configure_plugin_bundle(${target} "${P_ID}" "${P_NAME}")
        endif()
    endif()
endfunction()

function(cell_add_vst2_plugin target)
    _cell_plugin_arguments(P ${ARGN})
    if(NOT EXISTS "${P_VST2_SDK}/pluginterfaces/vst2.x/aeffectx.h")
        message(FATAL_ERROR "VST2_SDK must point to your separately supplied VST2.4 SDK")
    endif()
    if(NOT P_VST2_ID MATCHES "^0x[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]$")
        message(FATAL_ERROR "Supply an explicit eight-digit hexadecimal VST2_ID, preserving the established product ID")
    endif()
    if(P_VST2_ID STREQUAL "0x00000000")
        message(FATAL_ERROR "VST2_ID cannot be zero")
    endif()
    if(NOT P_VERSION_CODE)
        set(P_VERSION_CODE 10000)
    endif()
    if(NOT P_VERSION_CODE MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "VERSION_CODE must be a positive integer")
    endif()
    get_property(adapters GLOBAL PROPERTY CELL_ADAPTER_SOURCE_DIR)
    add_library(${target} MODULE "${adapters}/vst2.cpp")
    target_include_directories(${target} PRIVATE "${P_VST2_SDK}")
    target_link_libraries(${target} PRIVATE "${P_PROCESSOR}" Cell::Wrappers)
    if(P_UI)
        target_link_libraries(${target} PRIVATE Cell::UI)
    endif()
    target_compile_definitions(${target} PRIVATE "CELL_HAS_UI=$<BOOL:${P_UI}>"
        "CELL_VST2_UNIQUE_ID=${P_VST2_ID}" "CELL_PLUGIN_VERSION_CODE=${P_VERSION_CODE}")
    set_target_properties(${target} PROPERTIES PREFIX "" OUTPUT_NAME "${P_NAME}")
    if(APPLE)
        set_target_properties(${target} PROPERTIES BUNDLE TRUE BUNDLE_EXTENSION vst
            MACOSX_BUNDLE_GUI_IDENTIFIER "${P_ID}")
    endif()
endfunction()

# Metadata describes the processor's fixed port ordering and physical values.
function(cell_add_lv2_plugin target)
    cmake_parse_arguments(PARSE_ARGV 1 L "" "PROCESSOR;URI;LV2_SDK;DESCRIPTION;LV2_EDITOR_HTML;LV2_EDITOR_BINDINGS;LV2_EDITOR_METER_PORT" "")
    if(L_UNPARSED_ARGUMENTS OR NOT TARGET "${L_PROCESSOR}")
        message(FATAL_ERROR "LV2 requires a PROCESSOR target and recognized arguments")
    endif()
    if(NOT L_URI MATCHES "^https?://[A-Za-z0-9._~:/#-]+$")
        message(FATAL_ERROR "LV2 requires a stable HTTP(S) URI")
    endif()
    if(NOT EXISTS "${L_LV2_SDK}/include/lv2/core/lv2.h" OR NOT EXISTS "${L_DESCRIPTION}")
        message(FATAL_ERROR "LV2 requires the LV2 SDK checkout/install prefix and DESCRIPTION Turtle file")
    endif()
    if(L_KEYWORDS_MISSING_VALUES OR (DEFINED L_LV2_EDITOR_HTML AND NOT DEFINED L_LV2_EDITOR_BINDINGS)
       OR (DEFINED L_LV2_EDITOR_BINDINGS AND NOT DEFINED L_LV2_EDITOR_HTML)
       OR (DEFINED L_LV2_EDITOR_METER_PORT AND NOT DEFINED L_LV2_EDITOR_HTML))
        message(FATAL_ERROR "Set LV2_EDITOR_HTML and LV2_EDITOR_BINDINGS together before enabling LV2 editor meters")
    endif()
    get_property(adapters GLOBAL PROPERTY CELL_ADAPTER_SOURCE_DIR)
    add_library(${target} MODULE "${adapters}/lv2.cpp")
    target_link_libraries(${target} PRIVATE "${L_PROCESSOR}" Cell::Core)
    target_include_directories(${target} PRIVATE "${L_LV2_SDK}/include")
    target_compile_definitions(${target} PRIVATE "CELL_LV2_URI=\"${L_URI}\"")
    set(bundle "${CMAKE_CURRENT_BINARY_DIR}/${target}.lv2")
    if(CMAKE_CONFIGURATION_TYPES)
        set(bundle "${CMAKE_CURRENT_BINARY_DIR}/$<CONFIG>/${target}.lv2")
    endif()
    set_target_properties(${target} PROPERTIES PREFIX ""
        LIBRARY_OUTPUT_DIRECTORY "${bundle}/$<0:>"
        RUNTIME_OUTPUT_DIRECTORY "${bundle}/$<0:>"
        CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
    set(ui_manifest "")
    if(DEFINED L_LV2_EDITOR_HTML)
        if(NOT TARGET Cell::WebView OR NOT CMAKE_SYSTEM_NAME STREQUAL "Linux"
           OR NOT EXISTS "${L_LV2_SDK}/include/lv2/ui/ui.h")
            message(FATAL_ERROR "The LV2 designer editor requires Linux X11, Cell::WebView and the LV2 UI headers")
        endif()
        set(ui_target "${target}_UI")
        set(ui_uri "${L_URI}/designer")
        target_compile_definitions(${target} PRIVATE CELL_LV2_WEB_PROGRAMS=1)
        add_library(${ui_target} MODULE "${adapters}/lv2_ui.cpp")
        target_link_libraries(${ui_target} PRIVATE "${L_PROCESSOR}")
        target_include_directories(${ui_target} PRIVATE "${L_LV2_SDK}/include")
        target_compile_definitions(${ui_target} PRIVATE "CELL_LV2_URI=\"${L_URI}\"" "CELL_LV2_UI_URI=\"${ui_uri}\"")
        _cell_embed_designer_editor(${ui_target} LV2 "${L_LV2_EDITOR_HTML}" "${L_LV2_EDITOR_BINDINGS}")
        set_target_properties(${ui_target} PROPERTIES PREFIX ""
            LIBRARY_OUTPUT_DIRECTORY "${bundle}/$<0:>"
            CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
        add_dependencies(${target} ${ui_target})
        set(meter_metadata "")
        if(DEFINED L_LV2_EDITOR_METER_PORT)
            if(NOT L_LV2_EDITOR_METER_PORT MATCHES "^[1-9][0-9]*$" OR L_LV2_EDITOR_METER_PORT GREATER 4294967294)
                message(FATAL_ERROR "LV2_EDITOR_METER_PORT must be the first of two available LV2 port indices")
            endif()
            math(EXPR rms "${L_LV2_EDITOR_METER_PORT} + 1")
            target_compile_definitions(${target} PRIVATE "CELL_LV2_METER_PORT=${L_LV2_EDITOR_METER_PORT}u")
            target_compile_definitions(${ui_target} PRIVATE "CELL_LV2_METER_PORT=${L_LV2_EDITOR_METER_PORT}u")
            set(meter_metadata "
<${L_URI}> lv2:port
    [ a lv2:OutputPort, lv2:ControlPort ; lv2:index ${L_LV2_EDITOR_METER_PORT} ;
      lv2:symbol \"cell_output_peak\" ; lv2:name \"Output peak\" ;
      lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ],
    [ a lv2:OutputPort, lv2:ControlPort ; lv2:index ${rms} ;
      lv2:symbol \"cell_output_rms\" ; lv2:name \"Output RMS\" ;
      lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ] .
<${ui_uri}> ui:portNotification
    [ ui:plugin <${L_URI}> ; lv2:symbol \"cell_output_peak\" ; ui:protocol ui:floatProtocol ],
    [ ui:plugin <${L_URI}> ; lv2:symbol \"cell_output_rms\" ; ui:protocol ui:floatProtocol ] .
")
        endif()
        file(GENERATE OUTPUT "${bundle}/designer.ttl" CONTENT
"@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .
<${ui_uri}> lv2:requiredFeature ui:parent, ui:idleInterface ;
    lv2:optionalFeature ui:touch, ui:resize,
        <http://lv2plug.in/ns/ext/instance-access>, <http://lv2plug.in/ns/ext/data-access> ;
    lv2:extensionData ui:idleInterface, ui:resize .
${meter_metadata}")
        set(ui_manifest "
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .
<${L_URI}> ui:ui <${ui_uri}> ; rdfs:seeAlso <designer.ttl> .
<${ui_uri}> a ui:X11UI ; lv2:binary <$<TARGET_FILE_NAME:${ui_target}>> ;
    rdfs:seeAlso <designer.ttl> .
")
    endif()
    file(GENERATE OUTPUT "${bundle}/manifest.ttl" CONTENT
"@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
<${L_URI}> a lv2:Plugin ;
    lv2:binary <$<TARGET_FILE_NAME:${target}>> ;
    rdfs:seeAlso <plugin.ttl> .
${ui_manifest}")
    get_filename_component(description "${L_DESCRIPTION}" ABSOLUTE)
    file(GENERATE OUTPUT "${bundle}/plugin.ttl" INPUT "${description}")
endfunction()

function(cell_add_ladspa_plugin target)
    cmake_parse_arguments(L "DSSI" "PROCESSOR;INCLUDE_DIR;LABEL;UNIQUE_ID" "" ${ARGN})
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR "This LADSPA/DSSI build targets Linux")
    endif()
    if(L_UNPARSED_ARGUMENTS OR NOT TARGET "${L_PROCESSOR}" OR
       NOT L_LABEL MATCHES "^[A-Za-z_][A-Za-z0-9_]*$" OR
       NOT L_UNIQUE_ID MATCHES "^[1-9][0-9]*$" OR L_UNIQUE_ID GREATER 0xFFFFFF)
        message(FATAL_ERROR "LADSPA requires PROCESSOR, a stable LABEL and a positive 24-bit UNIQUE_ID")
    endif()
    if(NOT EXISTS "${L_INCLUDE_DIR}/ladspa.h" OR (L_DSSI AND NOT EXISTS "${L_INCLUDE_DIR}/dssi.h"))
        message(FATAL_ERROR "Pass INCLUDE_DIR with ladspa.h and, for DSSI, dssi.h and accessible ALSA headers")
    endif()
    get_property(adapters GLOBAL PROPERTY CELL_ADAPTER_SOURCE_DIR)
    add_library(${target} MODULE "${adapters}/ladspa.cpp")
    target_link_libraries(${target} PRIVATE "${L_PROCESSOR}" Cell::Core)
    target_include_directories(${target} PRIVATE "${L_INCLUDE_DIR}")
    target_compile_definitions(${target} PRIVATE "CELL_LADSPA_ID=${L_UNIQUE_ID}"
        "CELL_LADSPA_LABEL=\"${L_LABEL}\"" "CELL_HAS_DSSI=$<BOOL:${L_DSSI}>")
    set_target_properties(${target} PROPERTIES PREFIX "" CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
endfunction()
