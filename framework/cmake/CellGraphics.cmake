include_guard(GLOBAL)
# Same independent implementation in the product tree and source-only SDK.
function(cell_add_graphics root)
    add_library(cell_graphics STATIC "${root}/src/graphics_effects.cpp")
    add_library(Cell::Graphics ALIAS cell_graphics)
    add_library(cell::graphics ALIAS cell_graphics)
    set_target_properties(cell_graphics PROPERTIES EXPORT_NAME Graphics POSITION_INDEPENDENT_CODE ON)
    cell_apply_compiler_contract(cell_graphics)
    target_include_directories(cell_graphics PUBLIC
        $<BUILD_INTERFACE:${root}/include> $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
endfunction()
function(cell_add_ui_effects target root)
    target_sources(${target} PRIVATE "${root}/src/ui/effects.cpp")
    target_link_libraries(${target} PUBLIC cell_graphics)
endfunction()
function(cell_add_graphics_tests root ui_enabled)
    add_executable(cell_graphics_effects_tests "${root}/tests/graphics_effects_tests.cpp")
    target_link_libraries(cell_graphics_effects_tests PRIVATE cell_graphics)
    add_test(NAME cell_graphics_effects COMMAND cell_graphics_effects_tests)
    if(ui_enabled)
        add_executable(cell_ui_effects_tests "${root}/tests/ui_effects_tests.cpp")
        target_link_libraries(cell_ui_effects_tests PRIVATE cell_ui)
        add_test(NAME cell_ui_effects COMMAND cell_ui_effects_tests)
    endif()
endfunction()
