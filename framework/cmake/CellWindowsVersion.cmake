# Reusable PE version resources for Windows plugin targets.
function(cell_windows_version target)
    if(NOT WIN32)
        return()
    endif()
    cmake_parse_arguments(CELL_PE "" "NAME;COMPANY;VERSION;BASENAME" "" ${ARGN})
    if(NOT CELL_PE_VERSION MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
        message(FATAL_ERROR "cell_windows_version requires a three-part VERSION")
    endif()
    set(CELL_PE_NUMERIC "${CMAKE_MATCH_1},${CMAKE_MATCH_2},${CMAKE_MATCH_3},0")
    enable_language(RC)
    set(CELL_PE_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/${target}-version.rc")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CellWindowsVersion.rc.in" "${CELL_PE_OUTPUT}" @ONLY)
    target_sources(${target} PRIVATE "${CELL_PE_OUTPUT}")
endfunction()
