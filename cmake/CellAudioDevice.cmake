# Optional miniaudio device I/O. Product decoders do not depend on this target.
function(cell_add_audio_device source_root miniaudio_include)
    if(NOT EXISTS "${miniaudio_include}/miniaudio.h")
        message(FATAL_ERROR "Supply CELL_MINIAUDIO_INCLUDE_DIR containing miniaudio.h")
    endif()
    add_library(cell_audio_device STATIC "${source_root}/src/audio_device.cpp")
    add_library(Cell::AudioDevice ALIAS cell_audio_device)
    add_library(cell::audio_device ALIAS cell_audio_device)
    set_target_properties(cell_audio_device PROPERTIES EXPORT_NAME AudioDevice POSITION_INDEPENDENT_CODE ON)
    target_include_directories(cell_audio_device PRIVATE "${miniaudio_include}")
    target_link_libraries(cell_audio_device PUBLIC cell_core PRIVATE Threads::Threads ${CMAKE_DL_LIBS})
    if(WIN32)
        target_link_libraries(cell_audio_device PRIVATE ole32 winmm avrt uuid)
    elseif(APPLE)
        target_link_libraries(cell_audio_device PRIVATE "-framework CoreAudio" "-framework AudioToolbox" "-framework CoreFoundation")
    elseif(UNIX)
        target_link_libraries(cell_audio_device PRIVATE m)
    endif()
endfunction()
