cmake_minimum_required(VERSION 3.24)
project({{PROJECT_NAME}} VERSION 0.1.0 LANGUAGES CXX)

set(project_plugin_id "{{PLUGIN_ID}}")
set(identity_file "${CMAKE_CURRENT_SOURCE_DIR}/plugin-id.txt")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${identity_file}")
file(READ "${identity_file}" locked_plugin_id)
string(STRIP "${locked_plugin_id}" locked_plugin_id)
if(NOT "${project_plugin_id}" STREQUAL "${locked_plugin_id}")
    message(FATAL_ERROR
        "Plug-in ID changed from '${locked_plugin_id}' to '${project_plugin_id}'. Restore the released ID to preserve DAW session recall.")
endif()

if(ANDROID AND {{BUILD_ANDROID}})
    set(CELL_ANDROID_SDK_ROOT "" CACHE PATH "Directory containing one installed Cell SDK per ABI")
    if(CELL_ANDROID_SDK_ROOT AND NOT Cell_DIR)
        set(Cell_DIR "${CELL_ANDROID_SDK_ROOT}/${ANDROID_ABI}/lib/cmake/Cell")
    endif()
    set(CELL_ANDROID_EDITOR_DIR "${CMAKE_CURRENT_SOURCE_DIR}/editor" CACHE PATH "Folder containing both Designer exports")
    find_package(Cell CONFIG REQUIRED COMPONENTS DSP AudioDevice)
    add_library(project_processor STATIC processor.cpp)
    set_target_properties(project_processor PROPERTIES POSITION_INDEPENDENT_CODE ON)
    target_link_libraries(project_processor PUBLIC Cell::DSP)
    cell_add_android_designer_app(cell_android_designer project_processor
        "${CELL_ANDROID_EDITOR_DIR}/cell-plugin-editor.html" "${CELL_ANDROID_EDITOR_DIR}/cell-ui-bindings.hpp")
    return()
endif()

option(CELL_PROJECT_CLAP "Build the CLAP plug-in" {{BUILD_CLAP}})
option(CELL_PROJECT_VST3 "Build the VST3 plug-in" {{BUILD_VST3}})
option(CELL_PROJECT_LV2 "Build the LV2 plug-in" {{BUILD_LV2}})
option(CELL_PROJECT_AU "Build the macOS AUv2 plug-in" {{BUILD_AU}})
option(CELL_PROJECT_AUV3 "Build the AUv3 app extension and containing app" {{BUILD_AUV3}})
option(CELL_PROJECT_UI "Build the Cell native editor for CLAP and VST3" {{BUILD_UI}})
option(CELL_PROJECT_DESIGNER "Build the Cell UI Designer plug-in editor" {{BUILD_DESIGNER}})
set(CELL_PROJECT_CLAP_SDK "" CACHE PATH "Optional alternate official CLAP checkout")
set(CELL_PROJECT_VST3_SDK "" CACHE PATH "Complete official VST3 SDK checkout")
set(CELL_PROJECT_LV2_SDK "" CACHE PATH "Official LV2 SDK checkout or install prefix")
set(CELL_PROJECT_AU_SDK "" CACHE PATH "Apple AudioUnitSDK 1.4.0 checkout")
set(CELL_PROJECT_LV2_METER_PORT "5" CACHE STRING "First LV2 meter port index. Leave empty to disable LV2 meters.")
set(CELL_PROJECT_DESIGNER_DIR "${CMAKE_CURRENT_SOURCE_DIR}/editor" CACHE PATH "Folder containing the two Designer exports")

if(CELL_PROJECT_AU AND NOT CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    message(FATAL_ERROR "AUv2 requires a macOS target. Set CELL_PROJECT_AU=OFF to build other targets.")
endif()
if(CELL_PROJECT_AUV3 AND NOT CMAKE_SYSTEM_NAME MATCHES "^(Darwin|iOS)$")
    message(FATAL_ERROR "AUv3 requires a macOS or iOS target. Set CELL_PROJECT_AUV3=OFF to build other targets.")
endif()

set(components Core DSP AudioFiles)
if(CELL_PROJECT_UI)
    list(APPEND components UI)
endif()
set(clap_editor)
set(vst3_editor)
if(CELL_PROJECT_DESIGNER)
    if(CELL_PROJECT_UI)
        message(FATAL_ERROR "Choose either CELL_PROJECT_UI or CELL_PROJECT_DESIGNER")
    endif()
    set(html "${CELL_PROJECT_DESIGNER_DIR}/cell-plugin-editor.html")
    set(bindings "${CELL_PROJECT_DESIGNER_DIR}/cell-ui-bindings.hpp")
    foreach(asset IN ITEMS "${html}" "${bindings}")
        if(NOT EXISTS "${asset}" OR IS_DIRECTORY "${asset}")
            message(FATAL_ERROR "Designer export could not be found: ${asset}")
        endif()
    endforeach()
    if(CELL_PROJECT_CLAP OR CELL_PROJECT_VST3 OR CELL_PROJECT_LV2 OR CELL_PROJECT_AU)
        list(APPEND components WebView)
    endif()
    set(clap_editor CLAP_EDITOR_HTML "${html}" CLAP_EDITOR_BINDINGS "${bindings}")
    set(vst3_editor VST3_EDITOR_HTML "${html}" VST3_EDITOR_BINDINGS "${bindings}")
endif()
find_package(Cell CONFIG REQUIRED COMPONENTS ${components})

add_library(project_processor STATIC processor.cpp)
set_target_properties(project_processor PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_link_libraries(project_processor PUBLIC Cell::DSP)
if({{BANKED_FIXTURE}})
    target_compile_definitions(project_processor PRIVATE CELL_BANKED_EXAMPLE=1)
endif()

if(CELL_PROJECT_UI)
    target_sources(project_processor PRIVATE editor.cpp)
    target_link_libraries(project_processor PUBLIC Cell::UI)
    set(clap_editor UI)
    set(vst3_editor UI)
endif()

include(CTest)
if(NOT CMAKE_SYSTEM_NAME STREQUAL "iOS" AND NOT {{INSTRUMENT_TEMPLATE}})
    add_executable(project_render render.cpp)
    set_target_properties(project_render PROPERTIES OUTPUT_NAME "{{PROJECT_NAME}}")
    target_link_libraries(project_render PRIVATE project_processor Cell::AudioFiles)
endif()
if(BUILD_TESTING AND NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
    add_executable(project_smoke main.cpp)
    target_link_libraries(project_smoke PRIVATE project_processor)
    target_compile_definitions(project_smoke PRIVATE CELL_EXPECTED_PLUGIN_ID="${locked_plugin_id}")
    add_test(NAME processor_smoke COMMAND project_smoke)

    if({{BANKED_FIXTURE}})
        add_executable(project_banked_check banked_check.cpp)
        target_link_libraries(project_banked_check PRIVATE project_processor)
        add_test(NAME banked_panel_sysex COMMAND project_banked_check)
    endif()

    add_executable(project_parameter_identity parameter_identity.cpp)
    target_link_libraries(project_parameter_identity PRIVATE project_processor)
    add_test(NAME parameter_identity
        COMMAND project_parameter_identity parameter-ids.tsv
        WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}")
    if(CELL_PROJECT_DESIGNER)
        configure_file("${bindings}" "${CMAKE_CURRENT_BINARY_DIR}/designer/cell-ui-bindings.hpp" COPYONLY)
        target_include_directories(project_parameter_identity PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/designer")
        target_compile_definitions(project_parameter_identity PRIVATE CELL_PROJECT_CHECK_DESIGNER)
        add_test(NAME designer_bindings COMMAND project_parameter_identity --designer-bindings)
    endif()
endif()

set(clap_artifact "")
set(vst3_artifact "")
if(CELL_PROJECT_CLAP)
    if({{BANKED_FIXTURE}})
        list(APPEND clap_editor CLAP_EXPOSE_PROGRAMS)
    elseif({{INSTRUMENT_TEMPLATE}})
        list(APPEND clap_editor CLAP_INSTRUMENT)
    endif()
    cell_add_clap_plugin({{PROJECT_NAME}}_CLAP ${clap_editor} PROCESSOR project_processor
        ID "${project_plugin_id}" NAME "{{PROJECT_NAME}}" CLAP_SDK "${CELL_PROJECT_CLAP_SDK}")
    if(APPLE)
        set(clap_artifact "$<TARGET_BUNDLE_DIR:{{PROJECT_NAME}}_CLAP>")
    else()
        set(clap_artifact "$<TARGET_FILE:{{PROJECT_NAME}}_CLAP>")
    endif()
    if(BUILD_TESTING AND {{BANKED_FIXTURE}})
        add_executable(project_banked_clap_check banked_clap_check.cpp)
        get_target_property(clap_includes {{PROJECT_NAME}}_CLAP INCLUDE_DIRECTORIES)
        target_include_directories(project_banked_clap_check PRIVATE ${clap_includes})
        target_link_libraries(project_banked_clap_check PRIVATE Cell::Core ${CMAKE_DL_LIBS})
        add_test(NAME banked_clap_sysex COMMAND project_banked_clap_check
            "$<TARGET_FILE:{{PROJECT_NAME}}_CLAP>" "${clap_artifact}")
    endif()
endif()

if(CELL_PROJECT_VST3)
    if(NOT EXISTS "${CELL_PROJECT_VST3_SDK}/CMakeLists.txt")
        message(FATAL_ERROR "Set CELL_PROJECT_VST3_SDK to the complete official VST3 SDK checkout")
    endif()
    foreach(setting IN ITEMS SMTG_ADD_VSTGUI SMTG_ENABLE_VST3_PLUGIN_EXAMPLES
            SMTG_ENABLE_VST3_HOSTING_EXAMPLES SMTG_ENABLE_VSTGUI_SUPPORT
            SMTG_CREATE_PLUGIN_LINK SMTG_RUN_VST_VALIDATOR)
        set(${setting} OFF CACHE BOOL "Generated Cell project default" FORCE)
    endforeach()
    set(SMTG_PLUGIN_TARGET_PATH "" CACHE PATH "Optional VST3 install directory")
    add_subdirectory("${CELL_PROJECT_VST3_SDK}" vst3sdk EXCLUDE_FROM_ALL)
    cell_add_vst3_plugin({{PROJECT_NAME}}_VST3 ${vst3_editor} PROCESSOR project_processor
        ID "${project_plugin_id}" NAME "{{PROJECT_NAME}}" COMPANY "Cell Project" CATEGORIES "Fx|Tools")
    get_target_property(vst3_artifact {{PROJECT_NAME}}_VST3 SMTG_PLUGIN_PACKAGE_PATH)
endif()

set(lv2_artifact "")
if(CELL_PROJECT_LV2)
    set(project_lv2_uri "{{LV2_URI}}")
    set(lv2_identity_file "${CMAKE_CURRENT_SOURCE_DIR}/lv2-uri.txt")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lv2_identity_file}")
    file(READ "${lv2_identity_file}" locked_lv2_uri)
    string(STRIP "${locked_lv2_uri}" locked_lv2_uri)
    if(NOT "${project_lv2_uri}" STREQUAL "${locked_lv2_uri}")
        message(FATAL_ERROR
            "LV2 URI changed from '${locked_lv2_uri}' to '${project_lv2_uri}'. Restore the released URI to preserve DAW session recall.")
    endif()
    set(lv2_description "${CMAKE_CURRENT_BINARY_DIR}/lv2-plugin.ttl")
    configure_file(plugin.lv2.ttl.in "${lv2_description}" @ONLY)
    set(lv2_editor)
    if(CELL_PROJECT_DESIGNER)
        list(APPEND lv2_editor LV2_EDITOR_HTML "${html}" LV2_EDITOR_BINDINGS "${bindings}")
        if(NOT CELL_PROJECT_LV2_METER_PORT STREQUAL "")
            list(APPEND lv2_editor LV2_EDITOR_METER_PORT "${CELL_PROJECT_LV2_METER_PORT}")
        endif()
    endif()
    cell_add_lv2_plugin({{PROJECT_NAME}}_LV2 PROCESSOR project_processor
        URI "${project_lv2_uri}" LV2_SDK "${CELL_PROJECT_LV2_SDK}" DESCRIPTION "${lv2_description}" ${lv2_editor})
    set(lv2_artifact "$<TARGET_FILE_DIR:{{PROJECT_NAME}}_LV2>")
    if(BUILD_TESTING)
        add_executable(project_lv2_host legacy_effect_host.cpp)
        target_compile_definitions(project_lv2_host PRIVATE CELL_TEST_LV2=1)
        if(CELL_PROJECT_DESIGNER AND NOT CELL_PROJECT_LV2_METER_PORT STREQUAL "")
            target_compile_definitions(project_lv2_host PRIVATE CELL_TEST_LV2_METER_PORT=${CELL_PROJECT_LV2_METER_PORT})
        endif()
        target_include_directories(project_lv2_host PRIVATE "${CELL_PROJECT_LV2_SDK}/include")
        target_link_libraries(project_lv2_host PRIVATE Cell::Core ${CMAKE_DL_LIBS})
        add_dependencies(project_lv2_host {{PROJECT_NAME}}_LV2)
        add_test(NAME lv2_host COMMAND project_lv2_host "$<TARGET_FILE:{{PROJECT_NAME}}_LV2>" "${locked_lv2_uri}")
    endif()
endif()

set(au_artifact "")
set(auv3_artifact "")
if(CELL_PROJECT_AU OR CELL_PROJECT_AUV3)
    set(project_au_subtype "{{AU_SUBTYPE}}")
    set(project_au_manufacturer "{{AU_MANUFACTURER}}")
    set(au_identity_file "${CMAKE_CURRENT_SOURCE_DIR}/au-identity.txt")
    if(project_au_subtype STREQUAL "" OR project_au_manufacturer STREQUAL "" OR NOT EXISTS "${au_identity_file}")
        message(FATAL_ERROR "Generate the project with --au-subtype and --au-manufacturer to set its Audio Unit identity")
    endif()
    if(project_plugin_id MATCHES "_")
        message(FATAL_ERROR "An Audio Unit bundle ID may contain letters, digits, hyphens, and periods")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${au_identity_file}")
    file(READ "${au_identity_file}" locked_au_identity)
    string(STRIP "${locked_au_identity}" locked_au_identity)
    if(NOT "aufx\t${project_au_subtype}\t${project_au_manufacturer}" STREQUAL "${locked_au_identity}")
        message(FATAL_ERROR "Audio Unit component codes differ from au-identity.txt. Restore the released identity to preserve DAW session recall.")
    endif()

    foreach(part IN ITEMS MAJOR MINOR PATCH)
        if(NOT PROJECT_VERSION_${part} MATCHES "^[0-9]+$" OR PROJECT_VERSION_${part} GREATER 255)
            message(FATAL_ERROR "Audio Units need a three-part project version with each part between 0 and 255")
        endif()
    endforeach()
    math(EXPR au_version_code "(${PROJECT_VERSION_MAJOR} << 16) | (${PROJECT_VERSION_MINOR} << 8) | ${PROJECT_VERSION_PATCH}")
    if(NOT "${PROJECT_VERSION_TWEAK}" STREQUAL "" OR au_version_code EQUAL 0)
        message(FATAL_ERROR "Audio Units need a nonzero three-part project version")
    endif()
    set(au_arguments PROCESSOR project_processor NAME "{{PROJECT_NAME}}" COMPANY "Cell Project"
        AU_TYPE aufx AU_SUBTYPE "${project_au_subtype}" AU_MANUFACTURER "${project_au_manufacturer}"
        VERSION "${PROJECT_VERSION}" VERSION_CODE "${au_version_code}")
    set(au_editor)
    if(CELL_PROJECT_AUV3 OR CELL_PROJECT_DESIGNER)
        enable_language(OBJCXX)
    endif()
    if(CELL_PROJECT_DESIGNER)
        set(au_editor AU_EDITOR_HTML "${html}" AU_EDITOR_BINDINGS "${bindings}" AU_EDITOR_METERS)
    endif()
    string(HEX "${project_au_subtype}" au_subtype_hex)
    string(HEX "${project_au_manufacturer}" au_manufacturer_hex)
    set(au_host_definitions CELL_TEST_AU_SUBTYPE=0x${au_subtype_hex} CELL_TEST_AU_MANUFACTURER=0x${au_manufacturer_hex})
    if(BUILD_TESTING)
        find_package(Python3 REQUIRED COMPONENTS Interpreter)
    endif()
endif()

if(CELL_PROJECT_AU)
    cell_add_au_plugin({{PROJECT_NAME}}_AU ${au_arguments} ID "${project_plugin_id}"
        AU_SDK "${CELL_PROJECT_AU_SDK}" ${au_editor})
    set(au_artifact "$<TARGET_BUNDLE_DIR:{{PROJECT_NAME}}_AU>")

    if(BUILD_TESTING)
        add_test(NAME au_bundle COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/check_au_bundle.py"
            "${au_artifact}" "${au_identity_file}" "${locked_plugin_id}" "${PROJECT_VERSION}" "${au_version_code}")
        add_executable(project_au_render_check au_gain_host.cpp)
        target_compile_definitions(project_au_render_check PRIVATE ${au_host_definitions})
        target_link_libraries(project_au_render_check PRIVATE Cell::Core "-framework AudioToolbox" "-framework CoreFoundation")
        add_dependencies(project_au_render_check {{PROJECT_NAME}}_AU)
        if(CELL_PROJECT_DESIGNER)
            add_executable(project_au_cocoa_check EXCLUDE_FROM_ALL au_cocoa_editor.mm)
            set_target_properties(project_au_cocoa_check PROPERTIES OBJCXX_STANDARD 20
                OBJCXX_STANDARD_REQUIRED ON OBJCXX_EXTENSIONS OFF)
            target_compile_options(project_au_cocoa_check PRIVATE -fobjc-arc)
            target_compile_definitions(project_au_cocoa_check PRIVATE ${au_host_definitions})
            target_link_libraries(project_au_cocoa_check PRIVATE Cell::Core
                "-framework Cocoa" "-framework AudioToolbox" "-framework WebKit")
            add_dependencies(project_au_cocoa_check {{PROJECT_NAME}}_AU)
        endif()
    endif()
endif()

if(CELL_PROJECT_AUV3)
    set(auv3_target {{PROJECT_NAME}}_AUv3)
    cell_add_auv3_plugin(${auv3_target} ${au_arguments} ID "${project_plugin_id}.auv3" ${au_editor})
    set_target_properties(${auv3_target} PROPERTIES MACOSX_BUNDLE_BUNDLE_VERSION "${PROJECT_VERSION}")

    add_executable(project_auv3_app MACOSX_BUNDLE auv3_app.mm)
    set_target_properties(project_auv3_app PROPERTIES
        OUTPUT_NAME "{{PROJECT_NAME}}" MACOSX_BUNDLE_BUNDLE_NAME "{{PROJECT_NAME}}"
        MACOSX_BUNDLE_GUI_IDENTIFIER "${project_plugin_id}"
        MACOSX_BUNDLE_BUNDLE_VERSION "${PROJECT_VERSION}" MACOSX_BUNDLE_SHORT_VERSION_STRING "${PROJECT_VERSION}"
        XCODE_ATTRIBUTE_PRODUCT_BUNDLE_IDENTIFIER "${project_plugin_id}"
        OBJCXX_STANDARD 20 OBJCXX_STANDARD_REQUIRED ON OBJCXX_EXTENSIONS OFF)
    target_compile_options(project_auv3_app PRIVATE -fobjc-arc)
    target_compile_definitions(project_auv3_app PRIVATE CELL_AUV3_PROJECT ${au_host_definitions})
    if(CELL_PROJECT_DESIGNER)
        target_compile_definitions(project_auv3_app PRIVATE CELL_AUV3_PROJECT_EDITOR)
    endif()
    target_link_libraries(project_auv3_app PRIVATE Cell::Core "-framework Foundation"
        "-framework AudioToolbox" "-framework AVFoundation" "-framework CoreAudioKit")
    if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
        set_target_properties(project_auv3_app PROPERTIES
            MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_SOURCE_DIR}/auv3-app.plist.in")
        set_target_properties(project_auv3_app ${auv3_target} PROPERTIES XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY "1,2")
        target_link_libraries(project_auv3_app PRIVATE "-framework UIKit")
    else()
        target_link_libraries(project_auv3_app PRIVATE "-framework AppKit")
        set_target_properties(project_auv3_app PROPERTIES
            XCODE_ATTRIBUTE_CODE_SIGN_ENTITLEMENTS "${CMAKE_CURRENT_SOURCE_DIR}/auv3-app.entitlements")
    endif()
    cell_embed_auv3_extensions(project_auv3_app ${auv3_target})
    set(auv3_artifact "$<TARGET_BUNDLE_DIR:project_auv3_app>")

    if(BUILD_TESTING)
        set(auv3_check_editor)
        if(CELL_PROJECT_DESIGNER)
            set(auv3_check_editor --designer-html "${html}")
        endif()
        add_test(NAME auv3_bundle COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/check_au_bundle.py"
            --extension "$<TARGET_BUNDLE_DIR_NAME:${auv3_target}>" ${auv3_check_editor}
            "${auv3_artifact}" "${au_identity_file}" "${locked_plugin_id}" "${PROJECT_VERSION}" "${au_version_code}")
    endif()
endif()

# Write empty paths for disabled formats, including when reconfiguring an
# existing build directory that still contains an older plug-in binary.
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/cell-artifacts/$<CONFIG>/clap.txt"
    CONTENT "${clap_artifact}\n")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/cell-artifacts/$<CONFIG>/vst3.txt"
    CONTENT "${vst3_artifact}\n")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/cell-artifacts/$<CONFIG>/lv2.txt"
    CONTENT "${lv2_artifact}\n")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/cell-artifacts/$<CONFIG>/au.txt"
    CONTENT "${au_artifact}\n")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/cell-artifacts/$<CONFIG>/auv3.txt"
    CONTENT "${auv3_artifact}\n")
